# Public site URL (canonical + Open Graph). The GitHub Actions workflow sets this
# automatically from the Pages configuration; only needed for local overrides.
NEXT_PUBLIC_SITE_URL=https://aditya8321.github.io

# Base path for GitHub *project* pages (e.g. "/portfolio"). Leave empty for a
# user site (aditya8321.github.io) or a custom domain. Set by the workflow.
NEXT_PUBLIC_BASE_PATH=

# Contact form endpoint. Defaults to FormSubmit's AJAX endpoint for the site
# email (no account needed; first submission triggers a one-time activation
# email). Override with any endpoint that accepts JSON POSTs.
# NEXT_PUBLIC_FORM_ENDPOINT=https://formsubmit.co/ajax/you@example.com
